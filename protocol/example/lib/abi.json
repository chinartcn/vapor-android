{
  "schema": 1,
  "description": "扩展加载清单：kind=c 走 C ABI，kind=python 走内嵌解释器；arch 可限定 arm32/arm64/all",
  "extensions": [
    {
      "name": "hello_c",
      "kind": "c",
      "path": "libhello_c.so",
      "symbol": "vapor_ext_init",
      "arch": "all",
      "enabled": false
    },
    {
      "name": "hello_py",
      "kind": "python",
      "path": "hello_py.py",
      "arch": "all",
      "enabled": false
    },
    {
      "name": "font_ext",
      "kind": "python",
      "path": "font_ext.py",
      "arch": "all",
      "enabled": false
    },
    {
      "name": "hello_component",
      "kind": "python",
      "path": "hello_component.py",
      "arch": "all",
      "enabled": false
    },
    {
      "name": "component_abi",
      "kind": "c",
      "path": "libcomponent_abi.so",
      "symbol": "vapor_component_init",
      "arch": "all",
      "enabled": false
    }
  ]
}
